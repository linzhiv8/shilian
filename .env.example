# 部署用的环境变量。复制成 .env 再填：
#
#   cp .env.example .env
#
# docker compose 会自动读同目录下的 .env。
# 这个文件本身不含密钥，可以提交；.env 不要提交（已在 .gitignore 里）。

# ── 必填 ────────────────────────────────────────────────────────
# 没填的话 docker compose 会直接报错退出，不会带着空 Key 起一个坏服务
DEEPSEEK_API_KEY=sk-在这里填你的key

# MySQL 连接。**这个库要先自己建好**，见 DEPLOY.md 里的 CREATE DATABASE。
#
# ⚠ MYSQL_HOST 别写 127.0.0.1 —— 那是**容器自己**，不是宿主机。
#   情况对照：
#     MySQL 在宿主机上          → host.docker.internal（默认值）
#     MySQL 在另一台机器上      → 那台机器的 IP
#     MySQL 在别的容器/同一网络 → 那个容器的服务名
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=shilian
MYSQL_USER=shilian
MYSQL_PASSWORD=在这里填密码

# ── 可选 ────────────────────────────────────────────────────────

# 对外端口。80 被占了（比如宿主机已经有 nginx）就换一个
# HTTP_PORT=80

# 时区。影响周报和回顾的「今天」怎么算。
# 注意 MySQL 那边最好也是同一个时区，否则 JDBC 取到的时间会偏。
# TZ=Asia/Shanghai

# 日志级别。排查问题时临时改 DEBUG，平时 INFO
# LOG_LEVEL=INFO

# 上了 HTTPS 之后改成 true（走纯 HTTP 时开了会导致浏览器不发 cookie）
# COOKIE_SECURE=false

# 换模型
# DEEPSEEK_MODEL=deepseek-chat

# ── 语义搜索（不填的话那个按钮是灰的，其余功能不受影响）──────────
# DeepSeek 没有 embeddings 接口，所以向量必须来自另一套服务。
# EMBEDDING_API_KEY=sk-在这里填你的key
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3

# ── 抓取代理（服务器能直连外网就不要填）─────────────────────────
# ⚠ 这里填的地址是**从容器里**能不能访问到，127.0.0.1 指的是容器自己。
#   代理跑在宿主机上要用 host.docker.internal，或者宿主机的内网 IP。
# SHILIAN_FETCH_PROXY_HOST=host.docker.internal
# SHILIAN_FETCH_PROXY_PORT=7897
