# 本地配置。已 gitignore，不会提交。
# 复制本文件为 .env.properties 并填入真实值。
#
# 放哪儿：本文件应该待在 server/ 目录下（也就是和 pom.xml 同一层）。
# 后端启动时会同时找 ./ 和 ./server/ 两个位置，所以从工程根目录启动也能读到，
# 不用去改 IDEA 的 Working directory。

# ── MySQL 连接 ──────────────────────────────────────────────
# 默认值指向本机 3306 上的 shilian 库。连别的机器就改下面三行。
#
# ⚠ 这三项的名字是「环境变量的写法」（大写+下划线），不是 yml 里的点号写法。
#   因为 spring.config.import 把这个文件当普通 properties 读，
#   而 application.yml 里写的是 ${SPRING_DATASOURCE_URL:默认值}——
#   两边必须同名才接得上。写成 spring.datasource.url 是不生效的（而且不报错）。
#
# 注意 URL 末尾那四个参数别删，各自对应一个真实的坑：
#   useSSL=false                内网连接没有证书，开着要么握手失败要么一直警告
#   allowPublicKeyRetrieval     MySQL 8 默认 caching_sha2_password，不开 SSL 时
#                               首次认证要先取服务器公钥，否则报
#                               "Public Key Retrieval is not allowed"——
#                               这条报错和密码、权限都无关，很容易查错方向
#   connectionTimeZone=LOCAL    不指定的话驱动要去探测服务器时区，探不到就启动失败
#   rewriteBatchedStatements    把批量 insert 合成一条多值语句（补历史向量时差别明显）
#
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/shilian?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=LOCAL&rewriteBatchedStatements=true
# SPRING_DATASOURCE_USERNAME=shilian
# SPRING_DATASOURCE_PASSWORD=在这里填密码
#
# 连不上时看启动日志：框架的失败分析器会把整个异常堆栈换成一段可读提示，
# 里面有根因和一张六项对照表（域名 / 端口 / 防火墙 / 账号 / 库 / 认证插件）。

DEEPSEEK_API_KEY=sk-在这里填你的key
# 可选：换模型或走代理时才需要
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ── 语义搜索的向量服务（可选）──────────────────────────────
# 不填的话语义按钮保持灰色并说明原因，其余功能不受影响。
#
# 为什么不能复用上面的 DeepSeek Key：DeepSeek 只提供对话接口，
# 没有 embeddings 接口。所以向量必须来自另一套服务。
# 协议按 OpenAI 的 POST /embeddings 写的，换服务商只改这三个值。
#
# 方案一：本地 Ollama —— 零账号、离线、免费（推荐）
#   ollama pull bge-m3
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_API_KEY=ollama        （Ollama 会忽略这个值，但字段不能空）
#
# 方案二：硅基流动 —— 有免费额度，中文检索效果好
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_API_KEY=sk-在这里填你的key
#
# 阈值 min-score 默认 0.35，是估计值。校准方法见 application.yml 的注释。

# ── 抓取走的代理（可选）──────────────────────────────────────
# 不填 = 直连。填了之后「分析网址」会通过这个 HTTP 代理去抓。
#
# 什么时候需要：国内直连 github.com 这类站点，TCP 连接阶段就超时，
# 前端报的是「网络错误：HttpConnectTimeoutException」。
# 而浏览器能打开同一个网址——因为浏览器走系统代理，
# 而 Java 不会自动读系统代理（注册表和环境变量里的 http_proxy 都不看）。
#
# 怎么知道本机的代理地址：Windows「设置 → 网络和 Internet → 代理」，
# 或看代理软件（Clash Verge 默认就是 127.0.0.1:7897）。
# 注意这里填的是 HTTP 代理端口，不是 SOCKS 端口。
#
# shilian.fetch.proxy.host=127.0.0.1
# shilian.fetch.proxy.port=7897
